<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Zombies</AssemblyName>
    <RootNamespace>Game</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Survivalcraft.dll, Engine.dll y EntitySystem.dll deben estar en la misma carpeta que este archivo -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProjectDirectory)</GameDir>
    <NombreMod>Zombies_API1.8</NombreMod>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Zombies.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Survivalcraft">
      <HintPath>$(GameDir)\Survivalcraft.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Engine">
      <HintPath>$(GameDir)\Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EntitySystem">
      <HintPath>$(GameDir)\EntitySystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Al compilar: junta Zombies.dll + modinfo.json y crea el .scmod listo para usar -->
  <Target Name="Empaquetar" AfterTargets="Build">
    <PropertyGroup>
      <CarpetaPaquete>$(MSBuildProjectDirectory)\obj\paquete</CarpetaPaquete>
      <ArchivoMod>$(MSBuildProjectDirectory)\$(NombreMod).scmod</ArchivoMod>
    </PropertyGroup>
    <RemoveDir Directories="$(CarpetaPaquete)" />
    <MakeDir Directories="$(CarpetaPaquete)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\modinfo.json" DestinationFolder="$(CarpetaPaquete)" />
    <Delete Files="$(ArchivoMod)" />
    <ZipDirectory SourceDirectory="$(CarpetaPaquete)" DestinationFile="$(ArchivoMod)" />
    <Message Importance="high" Text="Mod empaquetado: $(ArchivoMod)" />
  </Target>

</Project>
